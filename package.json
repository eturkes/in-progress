{
  "name": "in-progress",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first browser control plane for coding agents",
  "type": "module",
  "scripts": {
    "build": "pnpm build:sdk && pnpm build:web && pnpm build:server",
    "build:sdk": "tsc -p packages/plugin-sdk/tsconfig.json",
    "build:server": "bun build src/server/index.ts --target=bun --outdir=dist/server --sourcemap=linked",
    "build:web": "vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "concurrently -k -n server,web -c green,cyan 'pnpm dev:server' 'pnpm dev:web'",
    "dev:server": "IN_PROGRESS_WEB_PROXY=http://127.0.0.1:5173 bun --watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src packages scripts tests vite.config.ts",
    "plugin:validate": "bun scripts/validate-plugin.ts",
    "start": "bun dist/server/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p packages/plugin-sdk/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/iosevka": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.5",
    "bun": "1.3.14",
    "concurrently": "9.2.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.3.0"
}
