{
  "$schema": "./docs/in-progress-config.schema.json",
  "server": {
    "host": "127.0.0.1",
    "port": 4317
  },
  "projects": [
    {
      "id": "in-progress",
      "name": "in-progress",
      "path": ".",
      "color": "#67d5b5"
    },
    {
      "id": "align",
      "name": "Align",
      "path": "./plugins/align",
      "color": "#e8b55b"
    },
    {
      "id": "drift",
      "name": "Drift",
      "path": "./plugins/drift",
      "color": "#62dfbc"
    },
    {
      "id": "preview",
      "name": "Preview",
      "path": "./plugins/preview",
      "color": "#4c57a8"
    },
    {
      "id": "tree-complete",
      "name": "Tree Complete",
      "path": "./plugins/tree-complete",
      "color": "#ccf45b"
    },
    {
      "id": "turbo-prompt",
      "name": "Turbo Prompt",
      "path": "./plugins/turbo-prompt",
      "color": "#315ed4"
    },
    {
      "id": "slide-gen",
      "name": "Slide Gen",
      "path": "./plugins/slide-gen",
      "color": "#d06545"
    }
  ],
  "pluginDirectories": [
    "./plugins/align/plugin",
    "./plugins/drift/plugin",
    "~/.local/share/in-progress/preview/in-progress-plugin",
    "./plugins/tree-complete/dist/plugin",
    "./plugins/turbo-prompt/dist",
    "./plugins/slide-gen/dist/plugin"
  ],
  "integrations": {
    "align": {
      "sourceDirectory": "./plugins/align",
      "pythonExecutable": "/usr/bin/python3"
    },
    "drift": {
      "executable": "./plugins/drift/target/release/drift",
      "sessionsDirectory": "~/.codex/sessions"
    },
    "preview": {
      "sourceDirectory": "./plugins/preview",
      "artifactDirectory": "~/.local/share/in-progress/preview",
      "codexExecutable": "/usr/bin/codex"
    },
    "treeComplete": {
      "sourceDirectory": "./plugins/tree-complete",
      "mode": "preview"
    },
    "slideGen": {
      "sourceDirectory": "./plugins/slide-gen",
      "artifactDirectory": "~/.local/share/in-progress/slide-gen",
      "executable": "./_build/native/release/build/cmd/slide-gen/slide-gen.exe",
      "codexExecutable": "/usr/bin/codex",
      "uvExecutable": "/usr/bin/uv",
      "chromiumfishExecutable": "~/.local/bin/chromiumfish"
    }
  },
  "terminal": {
    "scrollbackBytes": 1048576
  },
  "notifications": {
    "vapidSubject": "mailto:in-progress@localhost"
  }
}
